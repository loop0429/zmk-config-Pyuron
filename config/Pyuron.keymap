#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <13 12>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <16 17>;
        };
    };

    macros {
        onepass: onepass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp Z &kp R &kp K &kp NUMBER_9 &kp PERCENT &kp NUMBER_2 &kp NUMBER_2 &kp LS(F) &kp H &kp U &kp NUMBER_1 &kp NUMBER_8 &kp NUMBER_3 &kp LS(A) &kp S>;
            label = "ONEPASS";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W                  &kp E             &kp R             &kp T                     &kp Y      &kp U          &kp I        &kp O      &kp P
&kp A             &kp S                  &kp D             &kp F             &kp G                     &kp H      &kp J          &kp K        &kp L      &lt 2 MINUS
&mt LEFT_SHIFT Z  &kp X                  &kp C             &kp V             &kp B                     &mkp LCLK  &mkp RCLK      &kp N        &kp M      &kp COMMA
&kp DOT           &mt RIGHT_SHIFT SLASH  &mt LCTRL ESCAPE  &mt LEFT_ALT TAB  &mt LEFT_META LANG_HANJA  &kp SPACE  &kp BACKSPACE  &lt 1 ENTER  &kp COLON  &kp EQUAL
            >;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH           &kp DOLLAR            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2       &kp NUMBER_3       &kp NUMBER_0
&kp PERCENT      &kp AMPERSAND  &kp PIPE           &kp NON_US_BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NUMBER_4  &kp NUMBER_5       &kp NUMBER_6       &kp ASTERISK
&kp TILDE        &kp GRAVE      &kp DOUBLE_QUOTES  &kp SQT               &kp LEFT_BRACKET      &mkp MB1               &mkp MB2      &kp RIGHT_BRACKET  &kp NUMBER_7       &kp NUMBER_8
&kp NUMBER_9     &kp LCTRL      &onepass           &kp K_MUTE            &trans                &trans                 &trans        &trans             &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            >;
        };

        layer_2 {
            bindings = <
&kp F7          &kp LS(LG(NUMBER_4))  &trans     &trans             &trans    &trans  &kp LC(UP_ARROW)  &kp UP_ARROW    &kp LC(LEFT)          &kp LC(RIGHT)
&kp F12         &kp LS(LG(NUMBER_5))  &trans     &kp LS(LA(LC(F)))  &trans    &trans  &kp LEFT          &kp DOWN_ARROW  &kp RIGHT             &trans
&kp LEFT_SHIFT  &trans                &trans     &trans             &trans    &trans  &trans            &trans          &trans                &trans
&trans          &kp RIGHT_SHIFT       &kp LCTRL  &kp LEFT_ALT       &kp LGUI  &trans  &trans            &trans          &kp LS(LA(LC(LEFT)))  &kp LS(LA(LC(RIGHT)))
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans      &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans
&trans  &bt BT_CLR  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
